{
  "id": "plugin.com.pot-app.gemini-openai-compatible",
  "plugin_type": "translate",
  "icon": "gemini.svg",
  "display": "Gemini（OpenAI 兼容）",
  "homepage": "https://github.com/xyxxxx06221/pot-app-translate-plugin-gemini",
  "needs": [
    { "key": "apiKey", "display": "API 密钥", "type": "input" },
    {
      "key": "baseUrl",
      "display": "接口地址",
      "type": "input",
      "default": "https://generativelanguage.googleapis.com/v1beta/openai"
    },
    {
      "key": "model",
      "display": "模型名称",
      "type": "input",
      "default": "gemini-3.1-flash-lite"
    }
  ],
